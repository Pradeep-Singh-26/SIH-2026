# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=dam_flood_simulation

# JWT Security
JWT_SECRET_KEY=hydrological-dam-simulation-sih-secret-key-2026

# Hydrodynamic Engine Binary Paths (Optional, defaults to MOCK mode if binaries not found)
DELFT3D_BIN_PATH=dflowfm.exe
DUALSPHYSICS_BIN_PATH=DualSPHysics5.2_win64.exe

# Server Host & Port
HOST=127.0.0.1
PORT=8000
